# Model files (should be downloaded, not committed)
models/
*.mlpackage/
*.mlmodel
*.mlmodelc/
# Exception: the vendored Silero VAD ONNX model (voice_mode/silero_vad.py) is
# ~2MB, MIT-licensed, and needed at import/runtime with NO network access
# (unlike Whisper/Kokoro's much larger downloaded-at-install models) -- so
# it's committed rather than fetched. Both the directory AND the file must
# be un-ignored (git cannot re-include a file whose parent directory is
# itself excluded by an earlier pattern).
!voice_mode/resources/models/
!voice_mode/resources/models/silero_vad.onnx

# Coverage reports (duplicates removed - already in Python section)
coverage.xml
voicemode-install-feedback.md

# Local convenience symlink to voice-lab voices dir (per-developer, not shipped)
/voices
