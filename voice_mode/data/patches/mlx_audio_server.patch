--- a/server.py
+++ b/server.py
@@ -1088,6 +1088,11 @@
         stream=payload.stream,
     )
 
+    # voicemode-patch: honor OpenAI-style response_format. Upstream already
+    # reshapes text/json/verbose_json natively (absorbed from the original
+    # patch -- see VM-1126); this augments it by stripping whisper's
+    # trailing silence-hallucination segments before returning verbose_json
+    # below. See VM-1128.
     if response_format in ("text", "json", "verbose_json"):
         full: Optional[dict] = None
         accumulated = ""
@@ -1120,6 +1125,17 @@
 
         if full is None:
             full = {"text": accumulated}
+
+        # Whisper hallucinates empty / "." / "..." segments on trailing
+        # silence. Strip them so callers don't drown in noise.
+        segs = full.get("segments") or []
+        filtered = [
+            s for s in segs
+            if (s.get("text") or "").strip() not in ("", ".", "...")
+        ]
+        if filtered:
+            full = {**full, "segments": filtered}
+            full["text"] = "".join(s.get("text", "") for s in filtered)
 
         if response_format == "text":
             return PlainTextResponse((full.get("text") or "").strip())
